<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Missile Cam: BepInEx 5 client plugin for Nuclear Option.
    Builds against the game's own Managed DLLs. Nothing from the game is copied into the output (Private=false).
    GameManagedDir defaults to the client install. While /mnt/games is unavailable, a provisional type check can use
    the dedicated server's Managed folder (same build hash cb745d6c44f1):
      dotnet build -p:GameManagedDir=$HOME/Games/nuclear-option-server/NuclearOptionServer_Data/Managed
    A build is not a test. See NOTES.md.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NoMissileCam</AssemblyName>
    <RootNamespace>Talamander.MissileCam</RootNamespace>
    <Version>0.2.1</Version>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">/mnt/games/SteamLibrary/steamapps/common/Nuclear Option/NuclearOption_Data/Managed</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.21" PrivateAssets="all" />
    <Reference Include="$(GameManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/Mirage.dll" Private="false" />
    <Reference Include="$(GameManagedDir)/Rewired_Core.dll" Private="false" />
  </ItemGroup>
</Project>
